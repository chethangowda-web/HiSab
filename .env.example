# No keys are required to run BoliHisab.
# Primary voice transcription (Wispr Flow):
# WISPR_API_KEY=fl-...
# Primary cloud LLM for Indian languages/Hinglish (Sarvam 105B):
# SARVAM_API_KEY=...
# SARVAM_MODEL=sarvam-105b
# Optional "edge mode": URL of a local open-source model server (e.g. Ollama).
# LOCAL_LLM_URL=http://localhost:11434
# Call the employer from the Employers tab (Vobiz bridge call). All four are required to enable it.
# The worker's phone rings first; when they answer they are connected to the employer.
# The Vobiz number must be allowed to call Indian mobiles (trial accounts may only call verified numbers).
# VOBIZ_AUTH_ID=MA_XXXXXXXX
# VOBIZ_AUTH_TOKEN=...
# VOBIZ_FROM=+91XXXXXXXXXX
# PUBLIC_BASE_URL=https://your-app.up.railway.app
